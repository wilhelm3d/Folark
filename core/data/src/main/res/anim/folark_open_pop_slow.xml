<?xml version="1.0" encoding="utf-8"?>
<!-- Pop: the app springs up from small, a touch past full size and back. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <scale android:interpolator="@android:interpolator/overshoot" android:fromXScale="0.6" android:toXScale="1" android:fromYScale="0.6" android:toYScale="1" android:pivotX="50%" android:pivotY="50%" android:duration="600" />
    <alpha android:interpolator="@android:interpolator/decelerate_quad" android:fromAlpha="0" android:toAlpha="1" android:duration="330" />
</set>
